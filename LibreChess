<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LibreChess — Secure Online Chess & Real Matchmaking</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #161512;
            --bg-panel: #262421;
            --bg-sidebar: #1e1c19;
            --accent-green: #81b64c;
            --sq-light: #ebecd0;
            --sq-dark: #739552;
            --sq-highlight: rgba(245, 246, 130, 0.72);
            --sq-selected: rgba(245, 246, 130, 0.85);
        }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-main);
            color: #e2e8f0;
            overflow-x: hidden;
            user-select: none;
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #1a1917; }
        ::-webkit-scrollbar-thumb { background: #3d3a35; border-radius: 3px; }
        .board-container {
            aspect-ratio: 1 / 1;
            width: 100%;
            max-width: min(80vh, 640px);
            position: relative;
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.65);
        }
        .chess-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: repeat(8, 1fr);
            width: 100%;
            height: 100%;
        }
        .square {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .square.light { background-color: var(--sq-light); color: var(--sq-dark); }
        .square.dark { background-color: var(--sq-dark); color: var(--sq-light); }
        .square.last-move::before { content: ''; position: absolute; inset: 0; background-color: var(--sq-highlight); pointer-events: none; }
        .square.selected::before { content: ''; position: absolute; inset: 0; background-color: var(--sq-selected); pointer-events: none; }
        .square.in-check { background: radial-gradient(circle, rgba(239, 68, 68, 0.95) 0%, rgba(220, 38, 38, 0.7) 55%, rgba(185, 28, 28, 0) 80%) !important; }
        .legal-dot { width: 30%; height: 30%; background-color: rgba(20, 20, 20, 0.22); border-radius: 50%; pointer-events: none; z-index: 5; }
        .legal-capture { position: absolute; inset: 6%; border: 5px solid rgba(20, 20, 20, 0.22); border-radius: 50%; pointer-events: none; z-index: 5; }
        .piece-svg { width: 84%; height: 84%; z-index: 10; transition: transform 0.08s ease; filter: drop-shadow(0 2px 2px rgba(0,0,0,0.35)); cursor: grab; }
        .piece-svg:active { cursor: grabbing; transform: scale(1.08); }
        .dragging-ghost { position: fixed; pointer-events: none; z-index: 9999; width: 68px; height: 68px; transform: translate(-50%, -50%); filter: drop-shadow(0 8px 14px rgba(0,0,0,0.5)); }
        .coord-rank { position: absolute; top: 2px; left: 4px; font-size: 0.68rem; font-weight: 700; pointer-events: none; line-height: 1; }
        .coord-file { position: absolute; bottom: 2px; right: 4px; font-size: 0.68rem; font-weight: 700; pointer-events: none; line-height: 1; }
        .btn-primary { background: linear-gradient(180deg, #8cc353 0%, #73a83e 100%); box-shadow: 0 4px 0 #537b2b; transition: all 0.1s ease; }
        .btn-primary:hover { background: linear-gradient(180deg, #98cf5e 0%, #7eb446 100%); transform: translateY(-1px); }
        .btn-primary:active { transform: translateY(2px); box-shadow: 0 2px 0 #537b2b; }
        .eval-bar-container { width: 24px; height: 100%; background-color: #262421; border-radius: 4px; overflow: hidden; position: relative; border: 1px solid #3a3732; }
        .eval-bar-white { position: absolute; bottom: 0; left: 0; right: 0; background-color: #f1f5f9; transition: height 0.45s ease; }
    </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row bg-[#161512]">

    <!-- Auth / Profile Modal (Google Sign-In & Username Setup) -->
    <div id="auth-modal" class="fixed inset-0 bg-black/85 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-[#262421] border border-[#45413b] rounded-2xl p-6 shadow-2xl max-w-md w-full text-center space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-[#81b64c] flex items-center justify-center mx-auto shadow-lg">
                <svg viewBox="0 0 45 45" class="w-7 h-7"><path d="M22.5 9c-2.21 0-4 1.79-4 4 0 .89.29 1.71.78 2.38C17.33 16.5 16 18.59 16 21c0 2.03.94 3.84 2.41 5.03-3 1.06-7.41 5.55-7.41 13.47h23c0-7.92-4.41-12.41-7.41-13.47 1.47-1.19 2.41-3 2.41-5.03 0-2.41-1.33-4.5-3.28-5.62.49-.67.78-1.49.78-2.38 0-2.21-1.79-4-4-4z" fill="#fff"/></svg>
            </div>
            <div>
                <h2 class="text-2xl font-extrabold text-white tracking-tight">Welcome to LibreChess</h2>
                <p class="text-xs text-gray-400 mt-1">Enter your username and sign in to track your Elo rating on Vercel.</p>
            </div>
            <div class="space-y-3 text-left">
                <div>
                    <label class="text-xs font-semibold text-gray-300 block mb-1">Username</label>
                    <input id="setup-username" type="text" maxlength="20" placeholder="e.g. GrandmasterNeo" class="w-full bg-[#1a1816] border border-[#3d3934] rounded-lg px-3.5 py-2.5 text-white font-semibold text-sm focus:outline-none focus:border-[#81b64c]">
                </div>
            </div>
            <div class="space-y-2.5 pt-2">
                <button onclick="handleGoogleSignIn()" class="w-full py-3 rounded-xl bg-white hover:bg-gray-100 text-slate-900 font-bold text-sm shadow-md flex items-center justify-center gap-2.5 transition">
                    <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.13 0-5.78-2.11-6.73-4.96H1.18v3.15C3.16 21.32 7.23 24 12 24z"/><path fill="#FBBC05" d="M5.27 14.24c-.25-.72-.39-1.49-.39-2.24s.14-1.52.39-2.24V6.6H1.18C.43 8.11 0 9.8 0 12s.43 3.89 1.18 5.4l4.09-3.16z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.23 0 3.16 2.68 1.18 6.6l4.09 3.15c.95-2.85 3.6-4.96 6.73-4.96z"/></svg>
                    <span>Sign in with Google</span>
                </button>
                <button onclick="handleGuestEntry()" class="w-full py-2.5 rounded-xl bg-[#33302b] hover:bg-[#3f3b35] text-gray-300 font-semibold text-xs transition">
                    Continue as Guest
                </button>
            </div>
        </div>
    </div>

    <!-- Matchmaking Search Modal -->
    <div id="matchmaking-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-[#262421] border border-[#45413b] rounded-2xl p-6 shadow-2xl max-w-sm w-full text-center space-y-4">
            <div class="w-14 h-14 rounded-full bg-emerald-600/20 border border-emerald-500/40 flex items-center justify-center mx-auto text-2xl animate-spin">
                🌐
            </div>
            <div>
                <h3 class="font-extrabold text-white text-lg">Finding Real Match...</h3>
                <p id="matchmaking-status-text" class="text-xs text-gray-400 mt-1">Searching online player queue...</p>
            </div>
            <div class="bg-[#181614] p-3 rounded-xl border border-[#35322c] text-xs font-mono text-emerald-400">
                Your Elo: <span id="mm-user-elo" class="font-bold text-white">1200</span>
            </div>
            <button onclick="cancelMatchmaking()" class="w-full py-2.5 rounded-xl bg-red-950/60 hover:bg-red-900/80 text-red-200 border border-red-900/50 font-bold text-xs transition">
                Cancel Search
            </button>
        </div>
    </div>

    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-56 bg-[#1e1c19] border-b md:border-b-0 md:border-r border-[#2e2b26] flex flex-row md:flex-col justify-between shrink-0 z-30">
        <div class="flex flex-row md:flex-col items-center md:items-stretch w-full">
            <div class="p-4 flex items-center justify-between border-r md:border-r-0 md:border-b border-[#2e2b26]">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-lg bg-[#81b64c] flex items-center justify-center shadow-md shrink-0">
                        <svg viewBox="0 0 45 45" class="w-6 h-6"><path d="M22.5 9c-2.21 0-4 1.79-4 4 0 .89.29 1.71.78 2.38C17.33 16.5 16 18.59 16 21c0 2.03.94 3.84 2.41 5.03-3 1.06-7.41 5.55-7.41 13.47h23c0-7.92-4.41-12.41-7.41-13.47 1.47-1.19 2.41-3 2.41-5.03 0-2.41-1.33-4.5-3.28-5.62.49-.67.78-1.49.78-2.38 0-2.21-1.79-4-4-4z" fill="#fff"/></svg>
                    </div>
                    <div class="hidden sm:block">
                        <div class="font-extrabold text-white tracking-tight text-lg leading-none">Libre<span class="text-[#81b64c]">Chess</span></div>
                        <div id="sidebar-user-tag" class="text-[10px] font-semibold uppercase tracking-wider text-[#81b64c] mt-0.5">Player (1200)</div>
                    </div>
                </div>
            </div>

            <nav class="flex flex-row md:flex-col flex-1 justify-around md:justify-start py-1 md:py-3 gap-1 px-1 md:px-0">
                <button onclick="switchTab('play')" id="nav-play" class="flex items-center gap-3 px-3 md:px-5 py-2.5 md:py-3 text-sm font-semibold text-white bg-[#2c2925] border-l-4 border-[#81b64c] transition rounded md:rounded-none">
                    <span>Play</span>
                </button>
                <button onclick="switchTab('puzzles')" id="nav-puzzles" class="flex items-center gap-3 px-3 md:px-5 py-2.5 md:py-3 text-sm font-semibold text-gray-300 hover:bg-[#282521] hover:text-white transition rounded md:rounded-none">
                    <span>Puzzles</span>
                </button>
                <button onclick="switchTab('analysis')" id="nav-analysis" class="flex items-center gap-3 px-3 md:px-5 py-2.5 md:py-3 text-sm font-semibold text-gray-300 hover:bg-[#282521] hover:text-white transition rounded md:rounded-none">
                    <span>Analysis</span>
                </button>
            </nav>
        </div>

        <div class="hidden md:flex flex-col gap-3 p-4 border-t border-[#2e2b26] text-xs text-gray-400">
            <button onclick="openMatchmakingModal()" class="w-full py-2.5 px-3 rounded-lg bg-gradient-to-r from-emerald-600 to-[#81b64c] hover:from-emerald-500 hover:to-[#95cc5c] text-white font-bold text-xs shadow-lg flex items-center justify-center gap-2 transition">
                <span>🌐</span> Quick Matchmaking
            </button>
            <button onclick="openAuthModal()" class="w-full py-2 px-3 rounded bg-[#262421] hover:bg-[#302d29] text-gray-300 transition font-medium">
                👤 Switch Account
            </button>
        </div>
    </aside>

    <!-- Main Workspace -->
    <main class="flex-1 flex flex-col lg:flex-row items-center justify-center p-3 md:p-6 gap-5 max-w-[1440px] mx-auto w-full">
        <div class="flex flex-col items-center justify-center w-full lg:w-auto flex-1 max-w-[700px]">
            
            <!-- Top Player Bar -->
            <div class="w-full max-w-[min(80vh,640px)] flex items-center justify-between mb-2 px-1">
                <div class="flex items-center gap-2.5">
                    <div id="top-avatar" class="w-9 h-9 rounded bg-[#2c2925] border border-[#3f3b36] flex items-center justify-center text-lg shadow">🤖</div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span id="top-name" class="font-bold text-sm text-white">Club Bot</span>
                            <span id="top-rating" class="text-xs text-gray-400 font-mono">(1550)</span>
                            <span id="ai-thinking" class="hidden text-xs text-[#81b64c] animate-pulse font-semibold">thinking...</span>
                        </div>
                        <div id="top-captured" class="flex items-center gap-0.5 h-4 text-xs text-gray-300"></div>
                    </div>
                </div>
                <div id="top-clock" class="font-mono text-lg font-bold px-3.5 py-1.5 rounded bg-[#262421] text-gray-400 border border-[#36332e] min-w-[88px] text-center">10:00</div>
            </div>

            <!-- Eval Bar + Chessboard -->
            <div class="w-full flex items-center justify-center gap-2.5">
                <div id="eval-wrapper" class="hidden h-[min(80vw,80vh,640px)] flex flex-col items-center gap-1">
                    <span id="eval-score-top" class="text-[10px] font-mono font-bold text-gray-400">0.0</span>
                    <div class="eval-bar-container flex-1">
                        <div id="eval-bar-fill" class="eval-bar-white" style="height: 50%;"></div>
                    </div>
                    <span id="eval-score-bot" class="text-[10px] font-mono font-bold text-white">0.0</span>
                </div>

                <div class="board-container" id="board-wrapper">
                    <div id="chessboard" class="chess-grid"></div>
                    <svg id="arrow-overlay" class="absolute inset-0 w-full h-full pointer-events-none z-20" viewBox="0 0 800 800"></svg>
                </div>
            </div>

            <!-- Bottom Player Bar -->
            <div class="w-full max-w-[min(80vh,640px)] flex items-center justify-between mt-2 px-1">
                <div class="flex items-center gap-2.5">
                    <div id="bot-avatar" class="w-9 h-9 rounded bg-[#81b64c]/20 border border-[#81b64c]/50 flex items-center justify-center text-lg shadow">♟️</div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span id="bot-name" class="font-bold text-sm text-white">You</span>
                            <span id="bot-rating" class="text-xs text-gray-400 font-mono">(1200)</span>
                        </div>
                        <div id="bot-captured" class="flex items-center gap-0.5 h-4 text-xs text-gray-300"></div>
                    </div>
                </div>
                <div id="bot-clock" class="font-mono text-lg font-bold px-3.5 py-1.5 rounded bg-[#262421] text-white border border-[#36332e] min-w-[88px] text-center">10:00</div>
            </div>
        </div>

        <!-- Sidebar Panel Container -->
        <div class="w-full lg:w-[390px] bg-[#262421] border border-[#34312c] rounded-xl shadow-2xl flex flex-col h-[540px] lg:h-[min(85vh,700px)] overflow-hidden shrink-0">
            
            <!-- PLAY PANEL -->
            <div id="panel-play" class="flex flex-col h-full">
                <div class="p-3.5 border-b border-[#34312c] bg-[#211f1c] flex items-center justify-between gap-2">
                    <h2 class="font-bold text-sm text-white flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#81b64c]"></span> Play Chess
                    </h2>
                    <div class="flex items-center gap-1.5">
                        <button onclick="openMatchmakingModal()" class="text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white px-2.5 py-1.5 rounded-md transition shadow-xs">
                            🌐 Matchmaking
                        </button>
                        <button onclick="startNewGame()" class="text-xs font-semibold bg-[#33302b] hover:bg-[#3f3b35] text-white px-2.5 py-1.5 rounded-md transition">
                            + New
                        </button>
                    </div>
                </div>

                <!-- Match Status Bar -->
                <div id="matchmaking-status-bar" class="hidden bg-emerald-950/70 border-b border-emerald-500/30 px-3 py-2 flex items-center justify-between text-xs">
                    <span class="text-emerald-200 font-semibold truncate">Live Match Elo Rated</span>
                    <button onclick="leaveOnlineMatch()" class="px-2 py-0.5 rounded bg-red-900/50 hover:bg-red-800 text-red-200 font-bold text-[11px] transition">Resign / Leave</button>
                </div>

                <!-- Opponent & Time Selector -->
                <div id="play-config-bar" class="p-3 bg-[#1f1d1a] border-b border-[#34312c] space-y-2.5 text-xs">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-gray-400 block mb-1 font-medium">Opponent</label>
                            <select id="opponent-select" onchange="handleOpponentChange()" class="w-full bg-[#2c2925] border border-[#3d3934] rounded px-2.5 py-1.5 text-white font-medium focus:outline-none">
                                <option value="ai-3" selected>Bot: Club Player (1550)</option>
                                <option value="ai-1">Bot: Beginner (600)</option>
                                <option value="ai-4">Bot: Master (2000)</option>
                                <option value="human">Pass & Play</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-gray-400 block mb-1 font-medium">Time Control</label>
                            <select id="time-select" class="w-full bg-[#2c2925] border border-[#3d3934] rounded px-2.5 py-1.5 text-white font-medium focus:outline-none">
                                <option value="600|0" selected>Rapid 10 | 0</option>
                                <option value="180|2">Blitz 3 | 2</option>
                                <option value="0|0">Unlimited</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Move List -->
                <div class="flex-1 overflow-y-auto p-2" id="move-history-scroll">
                    <table class="w-full text-sm font-mono">
                        <tbody id="move-list-body" class="divide-y divide-[#2d2a26]"></tbody>
                    </table>
                    <div id="empty-moves-msg" class="h-full flex flex-col items-center justify-center text-gray-500 text-xs text-center p-6">
                        <p class="mb-1 font-semibold text-gray-400">Ready to play!</p>
                        <p>Make a move or click <strong class="text-emerald-400">Matchmaking</strong> to find real players online.</p>
                    </div>
                </div>

                <!-- Game Over Banner -->
                <div id="game-over-banner" class="hidden bg-[#1b1916] border-t border-b border-[#81b64c]/40 p-3.5 text-center">
                    <div id="game-over-title" class="font-extrabold text-lg text-white">White Won!</div>
                    <div id="game-over-reason" class="text-xs text-gray-400 mb-3">by Checkmate</div>
                    <button onclick="startNewGame()" class="px-4 py-1.5 rounded btn-primary text-white text-xs font-bold">Play Again</button>
                </div>

                <!-- Bottom Controls -->
                <div class="p-3 bg-[#1f1d1a] border-t border-[#34312c] flex gap-2">
                    <button onclick="flipBoard()" class="flex-1 py-2 bg-[#2d2a26] hover:bg-[#38342f] rounded text-gray-200 font-semibold text-xs transition">⇅ Flip Board</button>
                    <button onclick="undoMove()" class="flex-1 py-2 bg-[#2d2a26] hover:bg-[#38342f] rounded text-gray-200 font-semibold text-xs transition">↩ Undo</button>
                </div>
            </div>

            <!-- PUZZLES PANEL -->
            <div id="panel-puzzles" class="hidden flex-col h-full">
                <div class="p-4 border-b border-[#34312c] bg-[#211f1c] flex items-center justify-between">
                    <h2 class="font-bold text-base text-white">🧩 Daily Puzzles</h2>
                    <span class="text-xs font-mono font-bold text-amber-400">Rating: 1450</span>
                </div>
                <div class="p-6 flex-1 flex flex-col justify-center text-center space-y-4">
                    <div class="text-white font-bold">Mate in 1 Puzzle</div>
                    <p class="text-xs text-gray-400">Find the winning tactical blow on the board.</p>
                    <button onclick="loadPuzzle()" class="w-full py-3 rounded-lg btn-primary text-white font-bold text-sm">Next Puzzle →</button>
                </div>
            </div>

            <!-- ANALYSIS PANEL -->
            <div id="panel-analysis" class="hidden flex-col h-full">
                <div class="p-4 border-b border-[#34312c] bg-[#211f1c]">
                    <h2 class="font-bold text-base text-white">🦈 Stock Shark Analysis</h2>
                </div>
                <div class="p-4 flex-1 overflow-y-auto text-xs text-gray-300 space-y-3">
                    <div id="analysis-best-move" class="font-mono bg-[#181614] p-3 rounded border border-[#34312c]">Best move: analyzing...</div>
                </div>
            </div>

        </div>
    </main>

    <!-- Custom Toast -->
    <div id="toast-box" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="bg-[#262421] border-l-4 border-[#81b64c] text-white px-4 py-3 rounded-lg shadow-2xl text-sm font-medium">
            <span id="toast-message">Notification</span>
        </div>
    </div>

<script>
const PIECE_SVGS = {
