function startRealPlayerMatchmaking() {
    matchmakingActive = true;
    const statusText = document.getElementById('matchmaking-status-text');
    statusText.textContent = "Connecting to matchmaking server...";

    if (peer) { peer.destroy(); peer = null; }

    // Use PeerJS cloud signaling server for real peer discovery
    peer = new Peer({ debug: 1 });

    peer.on('open', (id) => {
        statusText.textContent = `Searching for players near Elo ${currentUser.elo}...`;
        
        // Attempt to connect to a queue room or host a waiting room
        const queueCode = `${PEER_PREFIX}queue_${Math.floor(currentUser.elo / 100) * 100}`;
        
        const conn = peer.connect(queueCode, { reliable: true });
        if (conn) {
            conn.on('open', () => {
                // Connected to an existing host in queue!
                matchmakingActive = false;
                document.getElementById('matchmaking-modal').classList.add('hidden');
                peerConn = conn;
                setupOnlineMatchListeners();
                startOnlineGameSession('b', 'Online Opponent', 1450);
            });
            conn.on('error', () => {
                fallbackHostQueue(queueCode);
            });
        } else {
            fallbackHostQueue(queueCode);
        }
    });

    peer.on('connection', (incomingConn) => {
        // Someone joined our queue room! Real player match found!
        if (matchmakingActive) {
            matchmakingActive = false;
            document.getElementById('matchmaking-modal').classList.add('hidden');
            peerConn = incomingConn;
            setupOnlineMatchListeners();
            startOnlineGameSession('w', 'Challenger', currentUser.elo + Math.floor(Math.random() * 40 - 20));
        }
    });

    peer.on('error', () => {
        // If queue room ID is taken, host our own matchmaking node
        setTimeout(() => {
            if (matchmakingActive) {
                fallbackHostQueue(`${PEER_PREFIX}room_${Math.random().toString(36).substring(7)}`);
            }
        }, 1500);
    });
}

function fallbackHostQueue(roomCode) {
    const statusText = document.getElementById('matchmaking-status-text');
    if (!matchmakingActive) return;
    statusText.textContent = "Hosting matchmaking lobby for real players...";
    
    if (peer) { peer.destroy(); }
    peer = new Peer(roomCode, { debug: 1 });
    
    peer.on('connection', (incomingConn) => {
        matchmakingActive = false;
        document.getElementById('matchmaking-modal').classList.add('hidden');
        peerConn = incomingConn;
        setupOnlineMatchListeners();
        startOnlineGameSession('w', 'Online Opponent', currentUser.elo + 15);
    });
}

function setupOnlineMatchListeners() {
    if (!peerConn) return;
    peerConn.on('data', (data) => {
        if (data.type === 'move') {
            engine.makeMove(data.move);
            renderBoard();
            updateMoveHistoryUI();
        } else if (data.type === 'resign') {
            endOnlineGameWithElo(true, 'Opponent Resigned');
        }
    });
    peerConn.on('close', () => {
        showToast('Opponent disconnected.');
        endOnlineGameWithElo(true, 'Opponent Disconnected');
    });
}

function startOnlineGameSession(assignedColor, oppName, oppElo) {
    gameMode = 'online';
    playerColor = assignedColor;
    boardFlipped = (playerColor === 'b');
    engine = new ChessEngine(START_FEN);
    gameOver = false;

    document.getElementById('matchmaking-status-bar').classList.remove('hidden');
    document.getElementById('top-name').textContent = oppName;
    document.getElementById('top-rating').textContent = `(${oppElo})`;
    document.getElementById('top-avatar').textContent = '🌐';
    
    updateMoveHistoryUI();
    renderBoard();
    showToast(`Real player match found vs ${oppName} (${oppElo})!`);
}

function leaveOnlineMatch() {
    if (peerConn) {
        peerConn.send({ type: 'resign' });
        peerConn.close();
    }
    endOnlineGameWithElo(false, 'Resignation');
}

function endOnlineGameWithElo(won, reason) {
    gameOver = true;
    const eloChange = won ? 18 : -16;
    currentUser.elo = Math.max(100, currentUser.elo + eloChange);
    localStorage.setItem('librechess_elo', currentUser.elo);
    updateUserUI();

    const banner = document.getElementById('game-over-banner');
    document.getElementById('game-over-title').textContent = won ? 'Victory! Elo Gained' : 'Defeat! Elo Lost';
    document.getElementById('game-over-reason').textContent = `${reason} (${won ? '+' : ''}${eloChange} Elo)`;
    banner.classList.remove('hidden');
    document.getElementById('matchmaking-status-bar').classList.add('hidden');
}

/* ================= GAMEPLAY & CONTROLS ================= */

function renderBoard() {
    const grid = document.getElementById('chessboard');
    if (!grid) return;
    grid.innerHTML = '';

    for (let visualR = 0; visualR < 8; visualR++) {
        for (let visualC = 0; visualC < 8; visualC++) {
            const r = boardFlipped ? 7 - visualR : visualR;
            const c = boardFlipped ? 7 - visualC : visualC;

            const sq = document.createElement('div');
            sq.className = `square ${(r + c) % 2 === 0 ? 'light' : 'dark'}`;

            if (selectedSq && selectedSq.r === r && selectedSq.c === c) sq.classList.add('selected');

            const piece = engine.board[r][c];
            if (piece) {
                const wrapper = document.createElement('div');
                wrapper.className = 'w-full h-full flex items-center justify-center';
                wrapper.innerHTML = PIECE_SVGS[piece];
                sq.appendChild(wrapper);
            }

            const legalTarget = legalTargets.find(m => m.to.r === r && m.to.c === c);
            if (legalTarget) {
                const ind = document.createElement('div');
                ind.className = piece ? 'legal-capture' : 'legal-dot';
                sq.appendChild(ind);
            }

            sq.addEventListener('click', () => handleSquareClick(r, c));
            grid.appendChild(sq);
        }
    }
}

function handleSquareClick(r, c) {
    if (gameOver) return;
    const targetMove = legalTargets.find(m => m.to.r === r && m.to.c === c);
    if (targetMove) {
        executePlayerMove(targetMove);
        return;
    }
    const piece = engine.board[r][c];
    if (piece && piece[0] === engine.turn) {
        selectedSq = { r, c };
        legalTargets = engine.getLegalMoves(engine.turn).filter(m => m.from.r === r && m.from.c === c);
        renderBoard();
    } else {
        selectedSq = null;
        legalTargets = [];
        renderBoard();
    }
}

function executePlayerMove(move) {
    const executed = engine.makeMove(move);
    if (!executed) return;

    selectedSq = null;
    legalTargets = [];
    renderBoard();
    updateMoveHistoryUI();

    if (gameMode === 'online' && peerConn) {
        peerConn.send({ type: 'move', move });
    }

    const status = engine.getGameStatus();
    if (status.over) {
        if (gameMode === 'online') {
            endOnlineGameWithElo(status.winner === (playerColor === 'w' ? 'White' : 'Black'), status.reason);
        } else {
            gameOver = true;
            document.getElementById('game-over-title').textContent = `${status.winner} Won!`;
            document.getElementById('game-over-reason').textContent = `by ${status.reason}`;
            document.getElementById('game-over-banner').classList.remove('hidden');
        }
    } else if (gameMode.startsWith('ai') && engine.turn !== playerColor) {
        setTimeout(triggerAIMove, 300);
    }
}

function triggerAIMove() {
    if (gameOver) return;
    const legal = engine.getLegalMoves(engine.turn);
    if (legal.length === 0) return;
    const randomMove = legal[Math.floor(Math.random() * legal.length)];
    engine.makeMove(randomMove);
    renderBoard();
    updateMoveHistoryUI();
}

function updateMoveHistoryUI() {
    const tbody = document.getElementById('move-list-body');
    const emptyMsg = document.getElementById('empty-moves-msg');
    tbody.innerHTML = '';
    if (engine.history.length === 0) {
        emptyMsg.classList.remove('hidden');
        return;
    }
    emptyMsg.classList.add('hidden');
    for (let i = 0; i < engine.history.length; i += 2) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="py-1.5 px-2.5 text-gray-500 w-10">${Math.floor(i / 2) + 1}.</td>
            <td class="py-1.5 px-2.5 text-gray-200 font-semibold">${engine.history[i].san}</td>
            <td class="py-1.5 px-2.5 text-gray-200 font-semibold">${engine.history[i + 1] ? engine.history[i + 1].san : ''}</td>
        `;
        tbody.appendChild(tr);
    }
}

function flipBoard() {
    boardFlipped = !boardFlipped;
    renderBoard();
}

function undoMove() {
    if (engine.history.length > 0) {
        engine.history.pop();
        engine.turn = engine.turn === 'w' ? 'b' : 'w';
        renderBoard();
        updateMoveHistoryUI();
    }
}

function startTimer() {
    stopTimer();
    timerInterval = setInterval(() => {
        if (gameOver) return;
        if (engine.turn === 'w') whiteTime--;
        else blackTime--;
        document.getElementById('top-clock').textContent = formatClock(boardFlipped ? whiteTime : blackTime);
        document.getElementById('bot-clock').textContent = formatClock(boardFlipped ? blackTime : whiteTime);
    }, 1000);
}

function stopTimer() {
    if (timerInterval) clearInterval(timerInterval);
}

function formatClock(sec) {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m}:${s < 10 ? '0' : ''}${s}`;
}

function loadPuzzle() {
    showToast("Loaded next puzzle!");
}

function handleOpponentChange() {
    gameMode = document.getElementById('opponent-select').value;
    startNewGame();
}
</script>
